# OpenAI (realtime / STT / TTS)
OPENAI_API_KEY=sk_test_xxxxx
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Gemini / Google (Live + STT/TTS via Gemini API key)
GEMINI_API_KEY=xxxxx
GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
GEMINI_REALTIME_VOICE=Puck
GOOGLE_STT_MODEL=gemini-2.5-flash
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
GOOGLE_TTS_VOICE=Kore

# Groq (default STT/TTS for pipeline + scoring LLM)
GROQ_API_KEY=gsk_xxxxx
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin

# Sarvam
SARVAM_API_KEY=xxxxx
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
SARVAM_LANGUAGE=en-IN

# Gradio cloned-voice TTS (POST {GRADIO_TTS_URL}{GRADIO_TTS_PATH})
GRADIO_TTS_URL=https://xxxxxx.gradio.live
# auto = discover from /config (Gradio 4–6 uses /gradio_api/run/predict)
GRADIO_TTS_PATH=auto
GRADIO_TTS_FN_INDEX=0

# Defaults used by realtime agent pipeline
DEFAULT_STT_PROVIDER=groq
DEFAULT_TTS_PROVIDER=gradio

AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_CODEC=pcm16
DB_PATH=./eval_results.db
RECORDINGS_DIR=./recordings
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0
LOG_LEVEL=DEBUG
